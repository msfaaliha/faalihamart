# FaalihaMart Environment Configuration Example
# Copy to .env and configure appropriately

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SESSION_TIMEOUT=3600

# Database Configuration
# SQLite local file path
DATABASE_FILE=faalihamart.db

# PostgreSQL (Production / Server Mode)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=faalihamart
PG_USER=faalihamart_user
PG_PASSWORD=change_this_in_production

# Logging
LOG_LEVEL=info

# AI Chatbot Configuration (Section 9 & 15)
# Set to 'mock' for offline canned FAQ responses or 'gemini' for live Gemini API calls
AI_CHAT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
CHAT_TIMEOUT_SECONDS=10
CHAT_RATE_LIMIT_PER_MINUTE=10
