{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080,
      "https": false
    }
  ],
  "threads_num": 4,
  "session_timeout": 3600,
  "document_root": "./static",
  "home_page": "index.html",
  "static_file_headers": [
    {
      "path": "/",
      "headers": [
        {
          "field": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "app": {
    "log": {
      "log_path": "./logs",
      "logfile_base_name": "faalihamart",
      "log_size_limit": 104857600,
      "log_level": "DEBUG"
    },
    "client_max_body_size": "10M",
    "use_session": true
  },
  "plugins": [
    {
      "name": "faaliha::faalihamart::plugin::DbPlugin",
      "dependencies": [],
      "config": {
        "database_file": "faalihamart.db"
      }
    }
  ],
  "custom_config": {
    "app_name": "FaalihaMart",
    "environment": "development"
  }
}
