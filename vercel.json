{
  "version": 2,
  "public": false,
  "rewrites": [
    { "source": "/api/v1/health", "destination": "/api/health" },
    { "source": "/api/v1/chat", "destination": "/api/chat" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/css/(.*)", "destination": "/static/css/$1" },
    { "source": "/js/(.*)", "destination": "/static/js/$1" },
    { "source": "/images/(.*)", "destination": "/static/images/$1" },
    { "source": "/(.*)", "destination": "/static/index.html" }
  ]
}
